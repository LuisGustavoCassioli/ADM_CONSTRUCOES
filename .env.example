# ==============================================================================
# CONFIGURAÇÕES DO SITE — ADM CONSTRUÇÕES E REFORMAS EM GERAL
# ==============================================================================
# Copie este arquivo para ".env" (ou configure as variáveis no painel da Vercel)
# Não insira números ou IDs fictícios em produção.

# Número oficial do WhatsApp no formato internacional (DDI + DDD + Número, apenas dígitos)
# Exemplo: 5511999999999 (Deixe em branco enquanto o número oficial não for confirmado)
VITE_WHATSAPP_NUMBER=

# Telefone formatado para exibição visual no site (opcional, ex: (11) 99999-9999)
VITE_DISPLAY_PHONE=

# URL canônica oficial do site em produção (sem barra no final)
# Exemplo: https://admconstrucoesereformas.com.br
VITE_SITE_URL=

# Caminho do arquivo original da logo (adicionado em public/assets/logo/logo-adm.jpg)
# Exemplo: /assets/logo/logo-adm.jpg
VITE_LOGO_PATH=

# Caminho de fotografia real para a seção Hero (quando adicionada em public/assets/)
VITE_HERO_IMAGE_PATH=

# ==============================================================================
# INTEGRAÇÕES DE ANALYTICS E MARKETING (OPCIONAIS)
# ==============================================================================
VITE_GTM_ID=
VITE_GA4_ID=
VITE_CLARITY_ID=
VITE_GOOGLE_ADS_ID=
VITE_GSC_VERIFICATION=

